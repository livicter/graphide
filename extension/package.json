{
  "name": "graphide",
  "displayName": "Graphide Review",
  "description": "Review agent changes as flow graphs — explorer workspaces over a closed IR, not a force-directed hairball.",
  "version": "0.1.15",
  "publisher": "graphide",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Visualization", "Other"],
  "activationEvents": [
    "onView:graphide.reviewView",
    "onCommand:graphide.review",
    "onCommand:graphide.install",
    "onCommand:graphide.stamp",
    "onCommand:graphide.skip"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "graphide.review",
        "title": "Graphide: Review Workspace",
        "icon": "$(git-compare)"
      },
      {
        "command": "graphide.openSource",
        "title": "Graphide: Open Node Source"
      },
      {
        "command": "graphide.install",
        "title": "Graphide: Install (one click)"
      },
      {
        "command": "graphide.stamp",
        "title": "Graphide: Stamp Current Flow"
      },
      {
        "command": "graphide.skip",
        "title": "Graphide: Skip Current Flow"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "graphide",
          "title": "Graphide",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "graphide": [
        {
          "type": "webview",
          "id": "graphide.reviewView",
          "name": "Flow Review"
        }
      ]
    },
    "configuration": {
      "title": "Graphide",
      "properties": {
        "graphide.cliPath": {
          "type": "string",
          "default": "",
          "description": "Optional override. Empty = ~/.graphide/graphide(.exe), then the extension bin/, then workspace target/. Building the CLI belongs in the Graphide source repo, never in the folder under review."
        },
        "graphide.packageRoot": {
          "type": "string",
          "default": "",
          "description": "Folder to review (e.g. SolarSim). Empty = the open workspace folder. Not the Graphide source tree unless you are reviewing Graphide itself."
        },
        "graphide.parentRoot": {
          "type": "string",
          "default": "",
          "description": "Parent revision root for coverage. Empty = git HEAD^ when the folder is a repo."
        },
        "graphide.promptFlows": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Default --flow prompts (name=hit,hit). The Review input can override these."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node ./scripts/bundle-cli.js && npm run compile && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.3.0"
  }
}
