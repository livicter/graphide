{
  "name": "graphide",
  "private": true,
  "description": "Graphide Review desk \u2014 workspace tests plus the webview verify harness",
  "scripts": {
    "verify": "node extension/scripts/check-immutable-specs.js && node extension/scripts/check-immutable-specs.js --self-test && node extension/scripts/check-map.js && node scripts/verify-graphide.js",
    "build:webview": "node extension/scripts/build-webview.mjs",
    "package": "node scripts/package-graphide.js",
    "check:package": "node scripts/check-package.js",
    "check:activation": "node scripts/check-activation.js",
    "verify:immutable": "node extension/scripts/check-immutable-specs.js",
    "verify:immutable:self-test": "node extension/scripts/check-immutable-specs.js --self-test",
    "immutable:write": "node extension/scripts/check-immutable-specs.js --write --allow-spec-mutation",
    "fs-sandbox:gate": "node extension/scripts/check-immutable-specs.js --gate-write"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.11.5",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
